---
import { svg } from './svg-registry';

interface Props { name: string; size?: string; label?: string; class?: string; }
const { name, size = '1.25em', label, class: className } = Astro.props;
---
<span
  class:list={['icon', className]}
  style={`--size:${size}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={svg(name)}
/>
