---
import type { ProjectItem } from '../../data/queries';
import type { Locale } from '../../i18n/locales';
import ProjectCard from './ProjectCard.astro';

interface Props { locale: Locale; projects: ProjectItem[]; level?: 'h2' | 'h3'; }
const { locale, projects, level } = Astro.props;
---
<div class="projects-grid">
  {projects.map((project) => <ProjectCard {locale} {project} {level} />)}
</div>

<script>
  import { initDialogs } from '../../ui/dialogs.client';
  initDialogs();
</script>

<style lang="scss">
  @use '../../styles/abstracts' as *;

  // Fixed column counts (1, 2, 4) so the four home projects never leave one card alone on a row.
  .projects-grid {
    display: grid;
    gap: var(--space-6);

    @include up('md') {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @include up('xl') {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
