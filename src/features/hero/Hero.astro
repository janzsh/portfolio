---
import Button from '../../ui/Button.astro';
import { decoration } from '../../ui/decorations';
import type { Profile } from '../../schemas/profile';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';
import { splitHeadline } from './headline';

interface Props { locale: Locale; profile: Profile; }
const { locale, profile } = Astro.props;
const t = ui(locale);
const { lead, accent } = splitHeadline(profile.headline);
---
<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <p class="hero__badge"><span class="hero__dot" aria-hidden="true"></span>{t.hero.eyebrow}</p>
    <h1 class="hero__title" id="hero-title">
      {lead}{' '}<span class="hero__mark">
        <span class="hero__gradient">{accent}</span>
        <span class="hero__curve" aria-hidden="true" set:html={decoration('curve-decoration')} />
      </span>
    </h1>
    <p class="hero__tagline">{profile.tagline}</p>
    <div class="hero__cta">
      <Button href="#contact">{t.hero.cta}</Button>
      <Button href="#projects" variant="ghost">{t.hero.secondaryCta}</Button>
    </div>
    <p class="hero__meta">{profile.role} · {profile.location} · {t.hero.available}</p>

    <dl class="hero__stats">
      {profile.stats.map((stat) => (
        <div class="hero__stat">
          <dt class="hero__stat-label">{stat.label}</dt>
          <dd class="hero__stat-value">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style lang="scss">
  @use '../../styles/abstracts' as *;

  .hero {
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + var(--space-16));
    padding-bottom: var(--space-24);

    &__inner {
      display: grid;
      justify-items: center;
      gap: var(--space-8);
      text-align: center;
    }

    &__badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      margin-bottom: calc(var(--space-2) * -1);
      padding: 0.35rem 0.9rem;
      font-size: 0.85rem;
      color: rgb(var(--color-fg-muted));
      background: rgba(var(--color-surface), 0.8);
      border: 1px solid rgb(var(--color-border-strong));
      border-radius: var(--radius-pill);
    }

    &__dot {
      width: 8px;
      height: 8px;
      background: rgb(var(--color-accent-3-text));
      border-radius: 50%;

      @include motion-safe {
        animation: pulse 2.2s infinite;
      }
    }

    &__title {
      max-width: 18ch;
      font-size: clamp(3.4rem, 9.5vw, 7.4rem);
      line-height: 0.92;
      text-wrap: balance;
    }

    &__mark {
      position: relative;
      display: inline-block;
      isolation: isolate;
    }

    // Large text only needs 3:1, but the pastel accent fill is below that on a light page,
    // so the gradient uses the deeper -text tones (identical to the neons in dark).
    &__gradient {
      color: transparent;
      background: linear-gradient(100deg, rgb(var(--color-accent-text)), rgb(var(--color-accent-2-text)));
      background-clip: text;
    }

    // Visible by default; only the draw-in animation hides it, and only when motion is allowed.
    &__curve {
      position: absolute;
      inset: auto -2% -0.09em;
      z-index: -1;
      height: 0.26em;
      color: rgb(var(--color-accent));
      opacity: 0.85;
      pointer-events: none;

      :global(svg) {
        width: 100%;
        height: 100%;
        overflow: visible;
      }

      :global(path) {
        stroke-width: 0.09em;

        @include motion-safe {
          stroke-dasharray: 1;
          animation: draw 1.1s 0.5s var(--ease) both;
        }
      }
    }

    // Pull the subtitle closer to the headline than the grid gap.
    &__tagline {
      max-width: 62ch;
      margin-top: calc(var(--space-4) * -1);
      font-size: clamp(1.05rem, 2vw, 1.25rem);
      color: rgb(var(--color-fg-muted));
      text-wrap: balance;
    }

    &__cta {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-3);
      margin-top: var(--space-2);
    }

    &__meta {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: rgb(var(--color-fg-faint));
    }

    &__stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
      gap: var(--space-4);
      width: 100%;
      margin: var(--space-8) 0 0;
      padding-top: var(--space-8);
      border-top: 1px solid rgb(var(--color-border));

      @include down('lg') {
        grid-template-columns: 1fr;
        gap: var(--space-6);
      }
    }

    &__stat {
      display: flex;
      flex-direction: column-reverse;
      align-items: center;
    }

    &__stat-label {
      margin-top: var(--space-2);
      font-size: 0.9rem;
      color: rgb(var(--color-fg-muted));
    }

    &__stat-value {
      margin: 0;
      font-family: var(--font-display);
      font-size: 3.4rem;
      font-weight: 600;
      line-height: 1;
      letter-spacing: -0.03em;
    }
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(var(--color-accent-3), 0.7);
    }

    70%,
    100% {
      box-shadow: 0 0 0 9px transparent;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }
</style>
