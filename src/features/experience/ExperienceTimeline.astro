---
import Timeline from '../../ui/Timeline.astro';
import type { Locale } from '../../i18n/locales';
import { ui } from '../../i18n/ui';
import ExperienceCard from './ExperienceCard.astro';
import { toExperienceView, type ExperienceEntry } from './to-view';

interface Props { locale: Locale; items: ExperienceEntry[]; }
const { locale, items } = Astro.props;
const t = ui(locale);
const views = items.map((item) => toExperienceView(item, locale, t.experience.present));
---
<Timeline>
  {views.map((entry) => <ExperienceCard {locale} {entry} />)}
</Timeline>
