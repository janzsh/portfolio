---
import Icon from '../../ui/Icon.astro';
import Tag from '../../ui/Tag.astro';
import TimelineItem from '../../ui/TimelineItem.astro';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';
import type { ExperienceView } from './to-view';

interface Props { locale: Locale; entry: ExperienceView; }
const { locale, entry: e } = Astro.props;
const t = ui(locale);
---
<TimelineItem
  id={`experience-${e.id}`}
  title={e.role}
  subtitle={e.company}
  summary={e.summary}
  month={e.startMonth}
  year={e.startYear}
  caption={e.duration}
  live={e.current}
  detailsLabel={`${t.common.details}: ${e.role}, ${e.company}`}
  closeLabel={t.common.close}
>
  <p slot="meta" class="experience-dialog__period"><Icon name="calendar" size="1em" />{e.period}<b>{e.duration}</b></p>
  <p class="experience-dialog__company">
    {e.url
      ? <a class="experience-dialog__link" href={e.url} target="_blank" rel="noopener noreferrer">{e.company}<Icon name="link" size="0.9em" /></a>
      : e.company}
    <span class="experience-dialog__where"> · {e.location} · {e.mode}</span>
  </p>
  <p class="experience-dialog__summary">{e.summary}</p>
  {e.responsibilities.length > 0 && (
    <div class="experience-dialog__block">
      <p class="experience-dialog__label">{t.experience.responsibilities}</p>
      <div class="experience-dialog__tags">{e.responsibilities.map((item) => <Tag tone="accent">{item}</Tag>)}</div>
    </div>
  )}
  <ul class="experience-dialog__impact">{e.achievements.map((achievement) => <li>{achievement}</li>)}</ul>
  <div class="experience-dialog__tags">{e.stack.map((item) => <Tag>{item}</Tag>)}</div>
</TimelineItem>

<style lang="scss">
  .experience-dialog {
    &__period {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-variant-numeric: tabular-nums;
      color: rgb(var(--color-fg-muted));

      b {
        padding: 0.15rem 0.6rem;
        font-weight: 500;
        color: rgb(var(--color-fg));
        border: 1px solid rgb(var(--color-border-strong));
        border-radius: var(--radius-pill);
      }
    }

    &__company {
      color: rgb(var(--color-accent-text));
    }

    &__link {
      display: inline-flex;
      align-items: center;
      gap: 6px;

      &:hover {
        text-decoration: underline;
      }
    }

    &__where {
      font-size: 0.9rem;
      color: rgb(var(--color-fg-muted));
    }

    &__summary {
      color: rgb(var(--color-fg-muted));
    }

    &__block {
      display: grid;
      gap: var(--space-2);
    }

    &__label {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgb(var(--color-fg-faint));
    }

    &__impact {
      display: grid;
      gap: var(--space-2);

      li {
        position: relative;
        padding-left: 1.4rem;
        font-size: 0.97rem;

        &::before {
          content: '';
          position: absolute;
          top: 0.7em;
          left: 0;
          width: 8px;
          height: 2px;
          background: rgb(var(--color-accent-text));
        }
      }
    }

    &__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
  }
</style>
