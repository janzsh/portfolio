---
import Section from '../../ui/Section.astro';
import Icon from '../../ui/Icon.astro';
import Timeline from '../../ui/Timeline.astro';
import TimelineItem from '../../ui/TimelineItem.astro';
import { dateBadge } from '../../domain/dates';
import type { Education } from '../../schemas/education';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';

interface Props { locale: Locale; items: (Education & { id: string })[]; }
const { locale, items } = Astro.props;
const t = ui(locale);
---
<Section id="education" eyebrow={t.sections.education} title={t.titles.education}>
  <Timeline>
    {items.map((item) => {
      const { month, year } = dateBadge(item.start, locale);
      return (
        <TimelineItem
          id={`education-${item.id}`}
          title={item.program}
          subtitle={item.institution}
          summary={item.summary}
          kicker={item.status}
          {month}
          {year}
          detailsLabel={`${t.common.details}: ${item.program}, ${item.institution}`}
          closeLabel={t.common.close}
        >
          <p slot="meta" class="education-dialog__status">{item.status}</p>
          <p class="education-dialog__school">{item.institution}</p>
          <p class="education-dialog__location"><Icon name="location" size="1em" />{item.location}</p>
          <p class="education-dialog__summary">{item.summary}</p>
        </TimelineItem>
      );
    })}
  </Timeline>
</Section>

<style lang="scss">
  .education-dialog {
    &__status {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgb(var(--color-accent-2-text));
    }

    &__school {
      color: rgb(var(--color-accent-text));
    }

    &__location {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: rgb(var(--color-fg-muted));
    }

    &__summary {
      color: rgb(var(--color-fg-muted));
    }
  }
</style>
