---
import { SITE } from '../../config/site';
import { alternates, localePath } from '../../i18n/paths';
import type { Locale } from '../../i18n/locales';
import { siteJsonLd } from './jsonld';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  jobTitle: string;
  /** Path without locale prefix ("" for home, "projects"...), used to build the hreflang set. */
  path?: string;
}
const { title, description, locale, jobTitle, path = '' } = Astro.props;

const absolute = (href: string) => new URL(href, SITE.url).href;
const canonical = absolute(Astro.url.pathname);
const ogImage = absolute('/og.png');
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates(path).map(({ locale: l, href }) => <link rel="alternate" hreflang={l} href={absolute(href)} />)}
<link rel="alternate" hreflang="x-default" href={absolute(localePath('en', path))} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale === 'es' ? 'es_CO' : 'en_US'} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(siteJsonLd({ jobTitle, description, locale }))} />
