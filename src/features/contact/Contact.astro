---
import Section from '../../ui/Section.astro';
import ContactForm from './ContactForm';
import { buildChannels } from './channels';
import { SITE } from '../../config/site';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = ui(locale);
const channels = buildChannels(SITE.social);
---
<Section id="contact" eyebrow={t.sections.contact} title={t.titles.contact}>
  <div class="contact">
    <div class="contact__side">
      <p class="contact__lead">{t.contactInfo.lead}</p>
      <p class="contact__direct">{t.contactInfo.direct}</p>
      <ul class="contact__channels">
        {channels.map((channel) => (
          <li>
            <a class="contact__channel" href={channel.href} target="_blank" rel="noopener noreferrer">
              <span class="contact__name">{channel.label}</span>
              <span class="contact__handle">{channel.value}<i class="contact__arrow" aria-hidden="true">↗</i></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="contact__panel">
      <ContactForm client:visible labels={t.contact} />
    </div>
  </div>
</Section>

<style lang="scss">
  @use '../../styles/abstracts' as *;

  // Open layout: no boxes, just hairlines, so the form and the links share one quiet rhythm.
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    align-items: start;
    gap: var(--space-12);

    @include down('lg') {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    &__lead {
      max-width: 40ch;
      font-size: 1.15rem;
      color: rgb(var(--color-fg-muted));
    }

    &__direct {
      margin-top: var(--space-8);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgb(var(--color-fg-faint));
    }

    &__channels {
      margin-top: var(--space-3);
      border-bottom: 1px solid rgb(var(--color-border));
    }

    &__channel {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-4);
      padding: 1rem 0;
      border-top: 1px solid rgb(var(--color-border));

      @include motion-safe {
        transition: color 0.2s, padding 0.2s;
      }

      &:hover {
        padding-inline: var(--space-2);
        color: rgb(var(--color-accent-text));
      }

      &:focus-visible {
        @include focus-ring;
      }
    }

    &__name {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgb(var(--color-fg-muted));
    }

    &__handle {
      font-weight: 500;
    }

    &__arrow {
      margin-inline-start: var(--space-2);
      font-style: normal;
      color: rgb(var(--color-fg-faint));
    }
  }
</style>
