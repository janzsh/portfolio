---
import Background from '../features/background/Background.astro';
import Footer from '../features/footer/Footer.astro';
import Header from '../features/header/Header.astro';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
import Head from './Head.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  jobTitle: string;
  /** Path without locale prefix ("" for home), for hreflang and the language switch. */
  path?: string;
  /** Section id to mark as current in the nav when not on the home page. */
  current?: string;
  onHome?: boolean;
}
const { locale, current, onHome = true, ...head } = Astro.props;
const t = ui(locale);
---
<!doctype html>
<html lang={locale}>
  <head><Head {locale} {...head} /></head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <Background />
    <Header {locale} {current} {onHome} path={head.path} />
    <main id="main"><slot /></main>
    <Footer {locale} />
  </body>
</html>
