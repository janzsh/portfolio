---
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
import Head from './Head.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  jobTitle: string;
  path?: string;
}
const { locale, ...head } = Astro.props;
const t = ui(locale);
---
<!doctype html>
<html lang={locale}>
  <head><Head {locale} {...head} /></head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
  </body>
</html>
