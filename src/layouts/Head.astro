---
import '@fontsource-variable/inter';
import '@fontsource-variable/teko';
import '@fontsource-variable/jetbrains-mono';
import '../styles/main.scss';
import Seo from '../features/seo/Seo.astro';
import type { Locale } from '../i18n/locales';
import { initTheme, THEME_KEY } from '../scripts/theme';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  jobTitle: string;
  path?: string;
  noindex?: boolean;
}
const { noindex, ...seo } = Astro.props;

// Serialized from the tested function so the storage key lives in one place.
const themeInit = `(${initTheme.toString()})(${JSON.stringify(THEME_KEY)})`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f6fc" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0c14" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex" />}
<script is:inline set:html={themeInit} />
<Seo {...seo} />
